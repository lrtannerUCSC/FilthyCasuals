        <ScriptCode>
            lv_targetUnit = gv_controlledUnits[lp_player];
            while (gv_wASDState[lp_player] != 0x0000) {
                UnitIssueOrder(
                    lv_targetUnit, 
                    OrderTargetingPoint(
