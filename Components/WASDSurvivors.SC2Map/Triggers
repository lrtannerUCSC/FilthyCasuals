    <Element Type="FunctionCall" Id="EE6A51F9">
        <FunctionDef Type="FunctionDef" Library="Ntve" Id="00000123"/>
        <ScriptCode>
            lv_targetUnit = gv_controlledUnits[lp_player];
            while (gv_wASDState[lp_player] != 0x0000) {
                UnitIssueOrder(
                    lv_targetUnit, 
                    OrderTargetingPoint(
                        AbilityCommand(&quot;move&quot;, 0), 
                        PointWithOffsetPolar(UnitGetPosition(lv_targetUnit), 1.2, gf_GetWASDAngle(lp_player) + CameraGetYaw(lp_player))
                        ), 
                    c_orderQueueReplace
                );
                Wait(0.0, c_timeGame);
            }
        </ScriptCode>
