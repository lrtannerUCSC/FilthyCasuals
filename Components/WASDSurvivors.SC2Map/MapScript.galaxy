    libNtve_gf_CreateDialogItemButton(gv_shipUpgradesDialog, 350, 50, c_anchorTopLeft, 50, 500, StringExternal("Param/Value/90081933"), StringExternal("Param/Value/53174881"), "");
    gv_shipWeaponsButton5 = DialogControlLastCreated();
    libNtve_gf_CreateDialogItemButton(gv_shipUpgradesDialog, 75, 50, c_anchorBottomRight, 25, 25, StringExternal("Param/Value/B07BACFE"), StringExternal("Param/Value/1197AFCD"), "");
    gv_backtoTerranShip = DialogControlLastCreated();
