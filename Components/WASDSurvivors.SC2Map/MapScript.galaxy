    gt_ProtossSpecialUpgradesButtons = TriggerCreate("gt_ProtossSpecialUpgradesButtons_Func");
    TriggerAddEventDialogControl(gt_ProtossSpecialUpgradesButtons, EventPlayer(), c_invalidDialogControlId, c_triggerControlEventTypeClick);
}

