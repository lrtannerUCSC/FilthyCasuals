            TechTreeUpgradeAddLevel(EventPlayer(), "TerranVehicleWeaponsLevel128", 1);
            DialogControlSetVisible(EventDialogControl(), PlayerGroupSingle(EventPlayer()), false);
        }

    }

    if ((EventDialogControl() == gv_weapons9)) {
        if ((PlayerGetPropertyInt(EventPlayer(), c_playerPropMinerals) >= 1000) && (TechTreeUpgradeCount(EventPlayer(), "ProtossAirWeaponsLevel128", c_techCountCompleteOnly) == 1)) {
            TechTreeUpgradeAddLevel(EventPlayer(), "ProtossAirWeaponsLevel129", 1);
            TechTreeUpgradeAddLevel(EventPlayer(), "ProtossGroundWeaponsLevel129", 1);
            TechTreeUpgradeAddLevel(EventPlayer(), "TerranInfantryWeaponsLevel129", 1);
            TechTreeUpgradeAddLevel(EventPlayer(), "TerranShipWeaponsLevel129", 1);
            TechTreeUpgradeAddLevel(EventPlayer(), "TerranVehicleWeaponsLevel129", 1);
            DialogControlSetVisible(EventDialogControl(), PlayerGroupSingle(EventPlayer()), false);
        }

    }

    if ((EventDialogControl() == gv_weapons10)) {
        if ((PlayerGetPropertyInt(EventPlayer(), c_playerPropMinerals) >= 1000) && (TechTreeUpgradeCount(EventPlayer(), "ProtossAirWeaponsLevel129", c_techCountCompleteOnly) == 1)) {
            TechTreeUpgradeAddLevel(EventPlayer(), "ProtossAirWeaponsLevel1210", 1);
            TechTreeUpgradeAddLevel(EventPlayer(), "ProtossGroundWeaponsLevel1210", 1);
            TechTreeUpgradeAddLevel(EventPlayer(), "TerranInfantryWeaponsLevel1210", 1);
            TechTreeUpgradeAddLevel(EventPlayer(), "TerranShipWeaponsLevel1210", 1);
            TechTreeUpgradeAddLevel(EventPlayer(), "TerranVehicleWeaponsLevel1210", 1);
            DialogControlSetVisible(EventDialogControl(), PlayerGroupSingle(EventPlayer()), false);
        }

    }

    if ((EventDialogControl() == gv_minimizeWeapons)) {
        DialogSetVisible(gv_weaponsDialog, PlayerGroupSingle(EventPlayer()), false);
        DialogSetVisible(gv_minimizedUpgradeDialog, PlayerGroupSingle(EventPlayer()), true);
    }

    if ((EventDialogControl() == gv_backtoMainWeapons)) {
        DialogSetVisible(gv_weaponsDialog, PlayerGroupSingle(EventPlayer()), false);
        DialogSetVisible(gv_upgradeMainDialog, PlayerGroupSingle(EventPlayer()), true);
    }

    return true;
}

