    gt_BarracksUnitGrouper = TriggerCreate("gt_BarracksUnitGrouper_Func");
    TriggerAddEventUnitCreated(gt_BarracksUnitGrouper, UnitRefFromUnit(UnitFromId(1146560453)), null, null);
}

