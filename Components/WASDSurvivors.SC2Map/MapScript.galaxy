            libNtve_gf_CreateUnitsWithDefaultFacing(1, "AutoTurret", 0, 1, PointFromId(1850934419));
            gv_secondaryWestTurret1 = UnitLastCreated();
        }

        if ((UnitGetType(gv_secondaryWestTurret2) != "AutoTurret") && (UnitGetType(gv_secondaryWestTurret2) != "GatlingTurret")) {
            PlayerModifyPropertyInt(1, c_playerPropMinerals, c_playerPropOperSubtract, 50);
