//--------------------------------------------------------------------------------------------------
// Trigger: Infantry Upgrades Buttons
//--------------------------------------------------------------------------------------------------
bool gt_InfantryUpgradesButtons_Func (bool testConds, bool runActions) {
    // Automatic Variable Declarations
    // Actions
    if (!runActions) {
        return true;
    }

    if ((EventDialogControl() == gv_infantryArmorButton1)) {
        if ((PlayerGetPropertyInt(EventPlayer(), c_playerPropMinerals) > 2500)) {
            libNtve_gf_SetUpgradeLevelForPlayer(EventPlayer(), "TerranInfantryArmorsLevel1", 1);
            DialogControlSetVisible(EventDialogControl(), PlayerGroupSingle(EventPlayer()), false);
        }

    }

    if ((EventDialogControl() == gv_infantryArmorButton2)) {
        if ((PlayerGetPropertyInt(EventPlayer(), c_playerPropMinerals) > 2500) && (TechTreeUpgradeCount(EventPlayer(), "TerranInfantryArmorsLevel1", c_techCountCompleteOnly) == 1)) {
            libNtve_gf_SetUpgradeLevelForPlayer(EventPlayer(), "TerranInfantryArmorsLevel2", 1);
            DialogControlDestroy(EventDialogControl());
        }

    }

    if ((EventDialogControl() == gv_infantryArmorButton3)) {
        if ((TechTreeUpgradeCount(EventPlayer(), "TerranInfantryArmorsLevel2", c_techCountCompleteOnly) == 1) && (PlayerGetPropertyInt(EventPlayer(), c_playerPropMinerals) > 2500)) {
            libNtve_gf_SetUpgradeLevelForPlayer(EventPlayer(), "TerranInfantryArmorsLevel3", 1);
            DialogControlSetVisible(EventDialogControl(), PlayerGroupSingle(EventPlayer()), false);
        }

    }

    if ((EventDialogControl() == gv_infantryArmorButton4)) {
        if ((TechTreeUpgradeCount(EventPlayer(), "TerranInfantryArmorsLevel3", c_techCountCompleteOnly) == 1) && (PlayerGetPropertyInt(EventPlayer(), c_playerPropMinerals) > 2500)) {
            libNtve_gf_SetUpgradeLevelForPlayer(EventPlayer(), "TerranInfantryArmorLevel4", 1);
            DialogControlSetVisible(EventDialogControl(), PlayerGroupSingle(EventPlayer()), false);
        }

    }

    if ((EventDialogControl() == gv_infantryArmorButton5)) {
        if ((TechTreeUpgradeCount(EventPlayer(), "TerranInfantryArmorLevel4", c_techCountCompleteOnly) == 1) && (PlayerGetPropertyInt(EventPlayer(), c_playerPropMinerals) > 2500)) {
            libNtve_gf_SetUpgradeLevelForPlayer(EventPlayer(), "TerranInfantryArmorLevel5", 1);
            DialogControlSetVisible(EventDialogControl(), PlayerGroupSingle(EventPlayer()), false);
        }

    }

    if ((EventDialogControl() == gv_infantryWeaponsButton1)) {
        if ((PlayerGetPropertyInt(EventPlayer(), c_playerPropMinerals) > 2500)) {
            libNtve_gf_SetUpgradeLevelForPlayer(EventPlayer(), "TerranInfantryWeaponsLevel1", 1);
            DialogControlSetVisible(EventDialogControl(), PlayerGroupSingle(EventPlayer()), false);
        }

    }

    if ((EventDialogControl() == gv_infantryWeaponsButton2)) {
        if ((TechTreeUpgradeCount(EventPlayer(), "TerranInfantryWeaponsLevel1", c_techCountCompleteOnly) == 1) && (PlayerGetPropertyInt(EventPlayer(), c_playerPropMinerals) > 2500)) {
            libNtve_gf_SetUpgradeLevelForPlayer(EventPlayer(), "TerranInfantryWeaponsLevel2", 1);
            DialogControlSetVisible(EventDialogControl(), PlayerGroupSingle(EventPlayer()), false);
        }

    }

    if ((EventDialogControl() == gv_infantryWeaponsButton3)) {
        if ((TechTreeUpgradeCount(EventPlayer(), "TerranInfantryWeaponsLevel2", c_techCountCompleteOnly) == 1) && (PlayerGetPropertyInt(EventPlayer(), c_playerPropMinerals) > 2500)) {
            libNtve_gf_SetUpgradeLevelForPlayer(EventPlayer(), "TerranInfantryWeaponsLevel3", 1);
            DialogControlSetVisible(EventDialogControl(), PlayerGroupSingle(EventPlayer()), false);
        }

    }

    if ((EventDialogControl() == gv_infantryWeaponsButton4)) {
        if ((TechTreeUpgradeCount(EventPlayer(), "TerranInfantryWeaponsLevel3", c_techCountCompleteOnly) == 1) && (PlayerGetPropertyInt(EventPlayer(), c_playerPropMinerals) > 2500)) {
            libNtve_gf_SetUpgradeLevelForPlayer(EventPlayer(), "TerranInfantryWeaponsLevel4", 1);
            DialogControlSetVisible(EventDialogControl(), PlayerGroupSingle(EventPlayer()), false);
        }

    }

    if ((EventDialogControl() == gv_infantryWeaponsButton5)) {
        if ((TechTreeUpgradeCount(EventPlayer(), "TerranInfantryWeaponsLevel4", c_techCountCompleteOnly) == 1) && (PlayerGetPropertyInt(EventPlayer(), c_playerPropMinerals) > 2500)) {
            libNtve_gf_SetUpgradeLevelForPlayer(EventPlayer(), "TerranInfantryWeaponsLevel5", 1);
            DialogControlSetVisible(EventDialogControl(), PlayerGroupSingle(EventPlayer()), false);
        }

    }

    if ((EventDialogControl() == gv_minimizeInfantryUpgradesDialog)) {
        DialogSetVisible(gv_infantryUpgradesDialog, PlayerGroupSingle(EventPlayer()), false);
        DialogSetVisible(gv_minimizedUpgradeDialog, PlayerGroupSingle(EventPlayer()), true);
    }

    if ((EventDialogControl() == gv_backtoTerranInfantry)) {
        DialogSetVisible(gv_infantryUpgradesDialog, PlayerGroupSingle(EventPlayer()), false);
        DialogSetVisible(gv_chooseUpgradesSectionTerran, PlayerGroupSingle(EventPlayer()), true);
    }

    return true;
}

