//--------------------------------------------------------------------------------------------------
// Trigger: Protoss Special Upgrades Buttons
//--------------------------------------------------------------------------------------------------
bool gt_ProtossSpecialUpgradesButtons_Func (bool testConds, bool runActions) {
    // Automatic Variable Declarations
    // Actions
    if (!runActions) {
        return true;
    }

    if ((EventDialogControl() == gv_gravitonCatapult)) {
        if ((PlayerGetPropertyInt(EventPlayer(), c_playerPropMinerals) > 500) && (PlayerGetPropertyInt(EventPlayer(), c_playerPropVespene) > 0)) {
            libNtve_gf_SetUpgradeLevelForPlayer(EventPlayer(), "CarrierLaunchSpeedUpgrade", 1);
            DialogControlSetVisible(EventDialogControl(), PlayerGroupSingle(EventPlayer()), false);
            PlayerModifyPropertyInt(EventPlayer(), c_playerPropVespene, c_playerPropOperSubtract, 1);
        }

    }

    if ((EventDialogControl() == gv_overcharge)) {
        if ((PlayerGetPropertyInt(EventPlayer(), c_playerPropMinerals) > 500) && (PlayerGetPropertyInt(EventPlayer(), c_playerPropVespene) > 0)) {
            libNtve_gf_SetUpgradeLevelForPlayer(EventPlayer(), "Overcharge", 1);
            DialogControlSetVisible(EventDialogControl(), PlayerGroupSingle(EventPlayer()), false);
            PlayerModifyPropertyInt(EventPlayer(), c_playerPropVespene, c_playerPropOperSubtract, 1);
        }

    }

    if ((EventDialogControl() == gv_deepDisruptors)) {
        if ((PlayerGetPropertyInt(EventPlayer(), c_playerPropMinerals) > 500) && (PlayerGetPropertyInt(EventPlayer(), c_playerPropVespene) > 0)) {
            libNtve_gf_SetUpgradeLevelForPlayer(EventPlayer(), "DeepDisruptors", 1);
            DialogControlSetVisible(EventDialogControl(), PlayerGroupSingle(EventPlayer()), false);
            PlayerModifyPropertyInt(EventPlayer(), c_playerPropVespene, c_playerPropOperSubtract, 1);
        }

    }

    if ((EventDialogControl() == gv_khaydarinAmulet)) {
        if ((PlayerGetPropertyInt(EventPlayer(), c_playerPropMinerals) > 400) && (PlayerGetPropertyInt(EventPlayer(), c_playerPropVespene) > 0)) {
            libNtve_gf_SetUpgradeLevelForPlayer(EventPlayer(), "HighTemplarKhaydarinAmulet", 1);
            DialogControlSetVisible(EventDialogControl(), PlayerGroupSingle(EventPlayer()), false);
            PlayerModifyPropertyInt(EventPlayer(), c_playerPropVespene, c_playerPropOperSubtract, 1);
        }

    }

    if ((EventDialogControl() == gv_psiStorm)) {
        if ((PlayerGetPropertyInt(EventPlayer(), c_playerPropMinerals) > 100)) {
            libNtve_gf_SetUpgradeLevelForPlayer(EventPlayer(), "PsiStormTech", 1);
            DialogControlSetVisible(EventDialogControl(), PlayerGroupSingle(EventPlayer()), false);
        }

    }

    if ((EventDialogControl() == gv_charge)) {
        if ((PlayerGetPropertyInt(EventPlayer(), c_playerPropMinerals) > 500)) {
            libNtve_gf_SetUpgradeLevelForPlayer(EventPlayer(), "Charge", 1);
            DialogControlSetVisible(EventDialogControl(), PlayerGroupSingle(EventPlayer()), false);
        }

    }

    if ((EventDialogControl() == gv_blink)) {
        if ((PlayerGetPropertyInt(EventPlayer(), c_playerPropMinerals) > 500) && (PlayerGetPropertyInt(EventPlayer(), c_playerPropVespene) > 0)) {
            libNtve_gf_SetUpgradeLevelForPlayer(EventPlayer(), "BlinkTech", 1);
            DialogControlSetVisible(EventDialogControl(), PlayerGroupSingle(EventPlayer()), false);
            PlayerModifyPropertyInt(EventPlayer(), c_playerPropVespene, c_playerPropOperSubtract, 1);
        }

    }

    if ((EventDialogControl() == gv_graviticBoostersDrive)) {
        if ((PlayerGetPropertyInt(EventPlayer(), c_playerPropMinerals) > 500)) {
            libNtve_gf_SetUpgradeLevelForPlayer(EventPlayer(), "ObserverGraviticBooster", 1);
            libNtve_gf_SetUpgradeLevelForPlayer(EventPlayer(), "GraviticDrive", 1);
            DialogControlSetVisible(EventDialogControl(), PlayerGroupSingle(EventPlayer()), false);
        }

    }

    if ((EventDialogControl() == gv_extendedThermalLance)) {
        if ((PlayerGetPropertyInt(EventPlayer(), c_playerPropMinerals) > 500) && (PlayerGetPropertyInt(EventPlayer(), c_playerPropVespene) > 0)) {
            libNtve_gf_SetUpgradeLevelForPlayer(EventPlayer(), "ExtendedThermalLance", 1);
            DialogControlSetVisible(EventDialogControl(), PlayerGroupSingle(EventPlayer()), false);
            PlayerModifyPropertyInt(EventPlayer(), c_playerPropVespene, c_playerPropOperSubtract, 1);
        }

    }

    if ((EventDialogControl() == gv_minimizeProtossSpecialUpgrades)) {
        DialogSetVisible(gv_protossSpecialUpgradesDialog, PlayerGroupSingle(EventPlayer()), false);
        DialogSetVisible(gv_minimizedUpgradeDialog, PlayerGroupSingle(EventPlayer()), true);
    }

    if ((EventDialogControl() == gv_backtoMainProtoss)) {
        DialogSetVisible(gv_protossSpecialUpgradesDialog, PlayerGroupSingle(EventPlayer()), false);
        DialogSetVisible(gv_upgradeMainDialog, PlayerGroupSingle(EventPlayer()), true);
    }

    return true;
}

