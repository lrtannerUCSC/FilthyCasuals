//--------------------------------------------------------------------------------------------------
// Trigger: Hatch 1a
//--------------------------------------------------------------------------------------------------
bool gt_Hatch1a_Func (bool testConds, bool runActions) {
    // Automatic Variable Declarations
    const int autoF382441D_ae = 5;
    const int autoF382441D_ai = 1;

    // Actions
    if (!runActions) {
        return true;
    }

    gv_revealH1 = VisRevealerLastCreated();
    gv_textH1 = TextTagLastCreated();
    TextTagSetColor(gv_textH1, c_textTagColorText, Color(100.00, 100.00, 0.00));
    gv_h1Level = 1;
    for ( ; ( (autoF382441D_ai >= 0 && gv_h1Level <= autoF382441D_ae) || (autoF382441D_ai < 0 && gv_h1Level >= autoF382441D_ae) ) ; gv_h1Level += autoF382441D_ai ) {
        TechTreeUpgradeAddLevel(8, "ZergHPUpgradeH1", 1);
        TechTreeUpgradeAddLevel(8, "ZergWeaponsH01", 1);
        TextTagSetText(gv_textH1, IntToText(gv_h1Level));
        Wait(120.0, c_timeGame);
        if (true) {
            Wait(120.0, c_timeGame);
        }

    }
    return true;
}

