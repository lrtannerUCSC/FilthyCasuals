fixed gf_GetWASDAngle (int lp_player) {
    // Variable Declarations
    int lv_tempBits;

    // Automatic Variable Declarations
    // Variable Initialization

    // Implementation
    lv_tempBits = gv_wASDState[lp_player]&0x0001;
    if(lv_tempBits == 0x0001) {
    	lv_tempBits = gv_wASDState[lp_player]&0x1010;
    	if(lv_tempBits == 0x0000)      { return 0.0; }   // W
    	else if(lv_tempBits == 0x1000) { return 315.0; } // W+D
    	else                           { return 45.0; }  // W+A or W+A+D
    } else {
    	lv_tempBits = gv_wASDState[lp_player]&0x1110;
    	if     (lv_tempBits == 0x0100) { return 180.0; } // S
    	else if(lv_tempBits == 0x1100) { return 225.0; } // S+D
    	else if(lv_tempBits == 0x1000) { return 270.0; } // D
    	else if(lv_tempBits == 0x0010) { return 90.0; }  // A
    	else if(lv_tempBits == 0x1010) { return 90.0; }  // A + D
    	else if(lv_tempBits == 0x0000) { return 0.0; }   // None
    	else                           { return 135.0; } // S+A or S+A+D
    }
}

trigger auto_gf_ProcessMovement_Trigger = null;
int auto_gf_ProcessMovement_lp_player;

void gf_ProcessMovement (int lp_player) {
    auto_gf_ProcessMovement_lp_player = lp_player;

    if (auto_gf_ProcessMovement_Trigger == null) {
        auto_gf_ProcessMovement_Trigger = TriggerCreate("auto_gf_ProcessMovement_TriggerFunc");
    }

    TriggerExecute(auto_gf_ProcessMovement_Trigger, false, false);
}

bool auto_gf_ProcessMovement_TriggerFunc (bool testConds, bool runActions) {
    int lp_player = auto_gf_ProcessMovement_lp_player;

    // Variable Declarations
    unit lv_targetUnit;

    // Automatic Variable Declarations
    // Variable Initialization

    // Implementation
    lv_targetUnit = gv_controlledUnits[lp_player];
    while (gv_wASDState[lp_player] != 0x0000) {
        UnitIssueOrder(
            lv_targetUnit, 
            OrderTargetingPoint(
                AbilityCommand("move", 0), 
                PointWithOffsetPolar(UnitGetPosition(lv_targetUnit), 1.2, gf_GetWASDAngle(lp_player) + CameraGetYaw(lp_player))
                ), 
            c_orderQueueReplace
        );
        Wait(0.0, c_timeGame);
    }
    return true;
}

void gf_WASDKeyDownCheck (int lp_player, int lp_keyPressed) {
    // Variable Declarations
    bool lv_originallyMoving;

    // Automatic Variable Declarations
    // Variable Initialization

    // Implementation
    if(gv_wASDState[lp_player] != 0x0000) {
        lv_originallyMoving = true;
    }
    if (lp_keyPressed == c_keyW) {
        gv_wASDState[lp_player] |= 0x0001;
    } else if (lp_keyPressed == c_keyA) {
        gv_wASDState[lp_player] |= 0x0010;
    } else if (lp_keyPressed == c_keyS) {
        gv_wASDState[lp_player] |= 0x0100;
    } else if (lp_keyPressed == c_keyD) {
        gv_wASDState[lp_player] |= 0x1000;
    }
    if(!lv_originallyMoving) {
        gf_ProcessMovement(lp_player);
    }
}

void gf_WASDKeyUpCheck (int lp_player, int lp_keyPressed) {
    // Automatic Variable Declarations
    // Implementation
    if (lp_keyPressed == c_keyW) {
        gv_wASDState[lp_player] ^= 0x0001;
    } else if (lp_keyPressed == c_keyA) {
        gv_wASDState[lp_player] ^= 0x0010;
    } else if (lp_keyPressed == c_keyS) {
        gv_wASDState[lp_player] ^= 0x0100;
    } else if (lp_keyPressed == c_keyD) {
        gv_wASDState[lp_player] ^= 0x1000;
    }
}

void gf_WASDSetControlledUnit (int lp_player, unit lp_unit) {
    // Automatic Variable Declarations
    // Implementation
    gv_controlledUnits[lp_player] = lp_unit;
}

//--------------------------------------------------------------------------------------------------
// Trigger: Melee Initialization
//--------------------------------------------------------------------------------------------------
bool gt_MeleeInitialization_Func (bool testConds, bool runActions) {
    // Automatic Variable Declarations
    unitgroup auto5480AAE8_g;
    int auto5480AAE8_u;
    unit auto5480AAE8_var;

    // Actions
    if (!runActions) {
        return true;
    }

    MeleeInitUnits();
    MeleeInitAI();
    auto5480AAE8_g = gv_civUnitGroup;
    auto5480AAE8_u = UnitGroupCount(auto5480AAE8_g, c_unitCountAll);
    for (;; auto5480AAE8_u -= 1) {
        auto5480AAE8_var = UnitGroupUnitFromEnd(auto5480AAE8_g, auto5480AAE8_u);
        if (auto5480AAE8_var == null) { break; }
        UnitIssueOrder(auto5480AAE8_var, OrderTargetingPoint(AbilityCommand("move", 0), RegionRandomPoint(RegionFromId(10))), c_orderQueueReplace);
    }
    PlayerModifyPropertyInt(1, c_playerPropMinerals, c_playerPropOperSetTo, 100);
    DialogCreate(500, 400, c_anchorCenter, 0, 0, true);
    gv_interact[0] = DialogLastCreated();
    VisRevealArea(1, RegionFromId(12), 0.0, false);
    return true;
}

//--------------------------------------------------------------------------------------------------
void gt_MeleeInitialization_Init () {
    gt_MeleeInitialization = TriggerCreate("gt_MeleeInitialization_Func");
    TriggerAddEventMapInit(gt_MeleeInitialization);
}

//--------------------------------------------------------------------------------------------------
// Trigger: Cleaning
//--------------------------------------------------------------------------------------------------
bool gt_Cleaning_Func (bool testConds, bool runActions) {
    // Automatic Variable Declarations
    unitgroup auto8F8F600D_g;
    int auto8F8F600D_u;
    unit auto8F8F600D_var;

    // Actions
    if (!runActions) {
        return true;
    }

    auto8F8F600D_g = gv_cleaningBotGroup;
    auto8F8F600D_u = UnitGroupCount(auto8F8F600D_g, c_unitCountAll);
    for (;; auto8F8F600D_u -= 1) {
        auto8F8F600D_var = UnitGroupUnitFromEnd(auto8F8F600D_g, auto8F8F600D_u);
        if (auto8F8F600D_var == null) { break; }
        UnitIssueOrder(auto8F8F600D_var, OrderTargetingUnit(AbilityCommand("move", 0), UnitGroupClosestToPoint(gv_bloodsplatGroup, UnitGetPosition(auto8F8F600D_var))), c_orderQueueAddToEnd);
        if ((UnitInRangeAndAbleToAttackTarget(auto8F8F600D_var, UnitGroupClosestToPoint(gv_bloodsplatGroup, UnitGetPosition(auto8F8F600D_var))) == true)) {
            PlayerModifyPropertyInt(1, c_playerPropMinerals, c_playerPropOperAdd, 10);
            UnitRemove(UnitGroupClosestToPoint(gv_bloodsplatGroup, UnitGetPosition(auto8F8F600D_var)));
            TriggerDebugOutput(1, StringExternal("Param/Value/235F016D"), true);
        }

    }
    return true;
}

//--------------------------------------------------------------------------------------------------
void gt_Cleaning_Init () {
    gt_Cleaning = TriggerCreate("gt_Cleaning_Func");
    TriggerAddEventTimePeriodic(gt_Cleaning, 0.1, c_timeGame);
}

//--------------------------------------------------------------------------------------------------
// Trigger: Loss Condition
//--------------------------------------------------------------------------------------------------
bool gt_LossCondition_Func (bool testConds, bool runActions) {
    // Automatic Variable Declarations
    // Conditions
    if (testConds) {
        if (!((UnitGetOwner(EventUnit()) == 1))) {
            return false;
        }

        if (!((UnitGroupHasUnit(gv_townStructuresGroup, EventUnit()) == true))) {
            return false;
        }
    }

    // Actions
    if (!runActions) {
        return true;
    }

    if ((UnitGroupCount(gv_townStructuresGroup, c_unitCountAlive) <= 0)) {
        GameOver(1, c_gameOverDefeat, true, true);
    }

    return true;
}

//--------------------------------------------------------------------------------------------------
void gt_LossCondition_Init () {
    gt_LossCondition = TriggerCreate("gt_LossCondition_Func");
    TriggerAddEventUnitDied(gt_LossCondition, null);
}

