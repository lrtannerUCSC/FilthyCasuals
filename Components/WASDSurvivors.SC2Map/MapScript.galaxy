    UIShowCinematicText(PlayerGroupAll(), StringExternal("Param/Value/6502F4E9"), 0.1, 3.0, SoundLink("Alert_ZergEvolutionComplete", 0));
    Wait(5.0, c_timeGame);
    UIHideCinematicText(PlayerGroupAll());
    SoundChannelMute(PlayerGroupAll(), c_soundCategoryMovement, false);
    SoundChannelMute(PlayerGroupAll(), c_soundCategoryMusic, false);
    SoundChannelMute(PlayerGroupAll(), c_soundCategoryCombat, false);
    TechTreeUpgradeAddLevel(8, "ZergHPUpgrade", 5);
    TechTreeUpgradeAddLevel(8, "ZergGroundArmorAI", 3);
    TechTreeUpgradeAddLevel(8, "ZergMissileWeaponsAI", 3);
    TechTreeUpgradeAddLevel(8, "ZergFlyerWeaponsAI", 3);
    TechTreeUpgradeAddLevel(8, "ZergMeleeWeaponsAI", 3);
    TechTreeUpgradeAddLevel(8, "ZergFlyerArmorAI", 3);
    TechTreeUpgradeAddLevel(7, "MissileTurretDamage", 5);
    TechTreeUpgradeAddLevel(7, "TerranHPUpgrade", 5);
    TechTreeUpgradeAddLevel(7, "UnknownUpgrade", 5);
    TechTreeUpgradeAddLevel(7, "TerranInfantryWeaponsAI", 1);
    TechTreeUpgradeAddLevel(7, "TerranInfantryArmorsAI", 1);
    TechTreeUpgradeAddLevel(7, "GroundArmorAI", 1);
    TechTreeUpgradeAddLevel(7, "ProtossShieldsAI", 1);
    TechTreeUpgradeAddLevel(7, "ProtossGroundWeaponsAI", 1);
    return true;
}

//--------------------------------------------------------------------------------------------------
void gt_Upgrade10_Init () {
    gt_Upgrade10 = TriggerCreate("gt_Upgrade10_Func");
}

//--------------------------------------------------------------------------------------------------
// Trigger: ZombieRunnerA
//--------------------------------------------------------------------------------------------------
bool gt_ZombieRunnerA_Func (bool testConds, bool runActions) {
    // Automatic Variable Declarations
    // Actions
    if (!runActions) {
        return true;
    }

    UnitIssueOrder(EventUnit(), OrderTargetingPoint(AbilityCommand("attack", 2), RegionRandomPoint(RegionFromId(4))), c_orderQueueReplace);
    return true;
}

//--------------------------------------------------------------------------------------------------
void gt_ZombieRunnerA_Init () {
    gt_ZombieRunnerA = TriggerCreate("gt_ZombieRunnerA_Func");
    TriggerAddEventUnitRegion(gt_ZombieRunnerA, null, RegionFromId(5), true);
}

//--------------------------------------------------------------------------------------------------
// Trigger: ZombieRunnerB
//--------------------------------------------------------------------------------------------------
bool gt_ZombieRunnerB_Func (bool testConds, bool runActions) {
    // Automatic Variable Declarations
    // Actions
    if (!runActions) {
        return true;
    }

    Wait(2.0, c_timeGame);
    UnitIssueOrder(EventUnit(), OrderTargetingPoint(AbilityCommand("attack", 2), PointFromId(1498365247)), c_orderQueueReplace);
    return true;
}

//--------------------------------------------------------------------------------------------------
void gt_ZombieRunnerB_Init () {
    gt_ZombieRunnerB = TriggerCreate("gt_ZombieRunnerB_Func");
    TriggerAddEventUnitRegion(gt_ZombieRunnerB, null, RegionFromId(6), true);
