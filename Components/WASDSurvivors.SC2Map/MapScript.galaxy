//--------------------------------------------------------------------------------------------------
// Trigger: Upgrades Dialog Buttons
//--------------------------------------------------------------------------------------------------
bool gt_UpgradesDialogButtons_Func (bool testConds, bool runActions) {
    // Automatic Variable Declarations
    // Actions
    if (!runActions) {
        return true;
    }

    if ((EventDialogControl() == gv_armorUpgrades)) {
        DialogSetVisible(gv_upgradeMainDialog, PlayerGroupSingle(EventPlayer()), false);
        DialogSetVisible(gv_armorDialog, PlayerGroupSingle(EventPlayer()), true);
    }

    if ((EventDialogControl() == gv_weaponUpgrades)) {
        DialogSetVisible(gv_upgradeMainDialog, PlayerGroupSingle(EventPlayer()), false);
        DialogSetVisible(gv_weaponsDialog, PlayerGroupSingle(EventPlayer()), true);
    }

    if ((EventDialogControl() == gv_eBayInteractButton)) {
        DialogSetVisible(gv_eBayInteractDialog, PlayerGroupSingle(EventPlayer()), false);
        DialogSetVisible(gv_eBayDialog, PlayerGroupSingle(EventPlayer()), true);
    }

    if ((EventDialogControl() == gv_barracksInteractButton)) {
        DialogSetVisible(gv_barracksInteractDialog, PlayerGroupSingle(EventPlayer()), false);
        DialogSetVisible(gv_barracksDialog, PlayerGroupSingle(EventPlayer()), true);
    }

    if ((EventDialogControl() == gv_townHallInteractButton)) {
        DialogSetVisible(gv_townHallInteractDialog, PlayerGroupSingle(EventPlayer()), false);
        DialogSetVisible(gv_townHallDialog, PlayerGroupSingle(EventPlayer()), true);
    }

    return true;
}

//--------------------------------------------------------------------------------------------------
