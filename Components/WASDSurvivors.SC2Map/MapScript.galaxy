//--------------------------------------------------------------------------------------------------
// Trigger: Ship Upgrades Buttons
//--------------------------------------------------------------------------------------------------
bool gt_ShipUpgradesButtons_Func (bool testConds, bool runActions) {
    // Automatic Variable Declarations
    // Actions
    if (!runActions) {
        return true;
    }

    if ((EventDialogControl() == gv_shipArmorButton1)) {
        if ((PlayerGetPropertyInt(EventPlayer(), c_playerPropMinerals) > 2500)) {
            libNtve_gf_SetUpgradeLevelForPlayer(EventPlayer(), "TerranShipArmorsLevel1", 1);
            DialogControlSetVisible(EventDialogControl(), PlayerGroupSingle(EventPlayer()), false);
        }

    }

    if ((EventDialogControl() == gv_shipArmorButton2)) {
        if ((PlayerGetPropertyInt(EventPlayer(), c_playerPropMinerals) > 2500) && (TechTreeUpgradeCount(EventPlayer(), "TerranShipArmorsLevel1", c_techCountCompleteOnly) == 1)) {
            libNtve_gf_SetUpgradeLevelForPlayer(EventPlayer(), "TerranShipArmorsLevel2", 1);
            DialogControlSetVisible(EventDialogControl(), PlayerGroupSingle(EventPlayer()), false);
        }

    }

    if ((EventDialogControl() == gv_shipArmorButton3)) {
        if ((TechTreeUpgradeCount(EventPlayer(), "TerranShipArmorsLevel2", c_techCountCompleteOnly) == 1) && (PlayerGetPropertyInt(EventPlayer(), c_playerPropMinerals) > 2500)) {
            libNtve_gf_SetUpgradeLevelForPlayer(EventPlayer(), "TerranShipArmorsLevel3", 1);
            DialogControlSetVisible(EventDialogControl(), PlayerGroupSingle(EventPlayer()), false);
        }

    }

    if ((EventDialogControl() == gv_shipArmorButton4)) {
        if ((TechTreeUpgradeCount(EventPlayer(), "TerranShipArmorsLevel3", c_techCountCompleteOnly) == 1) && (PlayerGetPropertyInt(EventPlayer(), c_playerPropMinerals) > 2500)) {
            libNtve_gf_SetUpgradeLevelForPlayer(EventPlayer(), "TerranShipPlatingLevel4", 1);
            DialogControlSetVisible(EventDialogControl(), PlayerGroupSingle(EventPlayer()), false);
        }

    }

    if ((EventDialogControl() == gv_shipArmorButton5)) {
        if ((TechTreeUpgradeCount(EventPlayer(), "TerranShipPlatingLevel4", c_techCountCompleteOnly) == 1) && (PlayerGetPropertyInt(EventPlayer(), c_playerPropMinerals) > 2500)) {
            libNtve_gf_SetUpgradeLevelForPlayer(EventPlayer(), "TerranShipPlatingLevel5", 1);
            DialogControlSetVisible(EventDialogControl(), PlayerGroupSingle(EventPlayer()), false);
        }

    }

    if ((EventDialogControl() == gv_shipWeaponsButton1)) {
        if ((PlayerGetPropertyInt(EventPlayer(), c_playerPropMinerals) > 2500)) {
            libNtve_gf_SetUpgradeLevelForPlayer(EventPlayer(), "TerranShipWeaponsLevel1", 1);
            DialogControlSetVisible(EventDialogControl(), PlayerGroupSingle(EventPlayer()), false);
        }

    }

    if ((EventDialogControl() == gv_shipWeaponsButton2)) {
        if ((TechTreeUpgradeCount(EventPlayer(), "TerranShipWeaponsLevel1", c_techCountCompleteOnly) == 1) && (PlayerGetPropertyInt(EventPlayer(), c_playerPropMinerals) > 2500)) {
            libNtve_gf_SetUpgradeLevelForPlayer(EventPlayer(), "TerranShipWeaponsLevel2", 1);
            DialogControlSetVisible(EventDialogControl(), PlayerGroupSingle(EventPlayer()), false);
        }

    }

    if ((EventDialogControl() == gv_shipWeaponsButton3)) {
        if ((TechTreeUpgradeCount(EventPlayer(), "TerranShipWeaponsLevel2", c_techCountCompleteOnly) == 1) && (PlayerGetPropertyInt(EventPlayer(), c_playerPropMinerals) > 2500)) {
            libNtve_gf_SetUpgradeLevelForPlayer(EventPlayer(), "TerranShipWeaponsLevel3", 1);
            DialogControlSetVisible(EventDialogControl(), PlayerGroupSingle(EventPlayer()), false);
        }

    }

    if ((EventDialogControl() == gv_shipWeaponsButton4)) {
        if ((TechTreeUpgradeCount(EventPlayer(), "TerranShipWeaponsLevel3", c_techCountCompleteOnly) == 1) && (PlayerGetPropertyInt(EventPlayer(), c_playerPropMinerals) > 2500)) {
            libNtve_gf_SetUpgradeLevelForPlayer(EventPlayer(), "TerranShipWeaponsLevel4", 1);
            DialogControlSetVisible(EventDialogControl(), PlayerGroupSingle(EventPlayer()), false);
        }

    }

    if ((EventDialogControl() == gv_shipWeaponsButton5)) {
        if ((TechTreeUpgradeCount(EventPlayer(), "TerranShipWeaponsLevel4", c_techCountCompleteOnly) == 1) && (PlayerGetPropertyInt(EventPlayer(), c_playerPropMinerals) > 2500)) {
            libNtve_gf_SetUpgradeLevelForPlayer(EventPlayer(), "TerranShipWeaponsLevel5", 1);
            DialogControlSetVisible(EventDialogControl(), PlayerGroupSingle(EventPlayer()), false);
        }

    }

    if ((EventDialogControl() == gv_minimizeShipUpgradesDialog)) {
        DialogSetVisible(gv_shipUpgradesDialog, PlayerGroupSingle(EventPlayer()), false);
        DialogSetVisible(gv_minimizedUpgradeDialog, PlayerGroupSingle(EventPlayer()), true);
    }

    if ((EventDialogControl() == gv_backtoTerranShip)) {
        DialogSetVisible(gv_shipUpgradesDialog, PlayerGroupSingle(EventPlayer()), false);
        DialogSetVisible(gv_chooseUpgradesSectionTerran, PlayerGroupSingle(EventPlayer()), true);
    }

    return true;
}

//--------------------------------------------------------------------------------------------------
void gt_ShipUpgradesButtons_Init () {
    gt_ShipUpgradesButtons = TriggerCreate("gt_ShipUpgradesButtons_Func");
    TriggerAddEventDialogControl(gt_ShipUpgradesButtons, EventPlayer(), c_invalidDialogControlId, c_triggerControlEventTypeClick);
}

//--------------------------------------------------------------------------------------------------
// Trigger: Upgrade 1
//--------------------------------------------------------------------------------------------------
bool gt_Upgrade1_Func (bool testConds, bool runActions) {
    // Automatic Variable Declarations
    // Actions
    if (!runActions) {
        return true;
    }

    SoundChannelMute(PlayerGroupAll(), c_soundCategoryMovement, true);
    SoundChannelMute(PlayerGroupAll(), c_soundCategoryMusic, true);
    SoundChannelMute(PlayerGroupAll(), c_soundCategoryCombat, true);
    UIShowCinematicText(PlayerGroupAll(), StringExternal("Param/Value/268F5534"), 0.1, 3.0, SoundLink("Alert_ZergEvolutionComplete", 0));
    Wait(5.0, c_timeGame);
    UIHideCinematicText(PlayerGroupAll());
    SoundChannelMute(PlayerGroupAll(), c_soundCategoryMovement, false);
    SoundChannelMute(PlayerGroupAll(), c_soundCategoryMusic, false);
    SoundChannelMute(PlayerGroupAll(), c_soundCategoryCombat, false);
    TechTreeUpgradeAddLevel(8, "ZergHPUpgrade", 5);
    TechTreeUpgradeAddLevel(8, "ZergGroundArmorAI", 2);
    TechTreeUpgradeAddLevel(8, "ZergMissileWeaponsAI", 2);
    TechTreeUpgradeAddLevel(8, "ZergFlyerWeaponsAI", 2);
    TechTreeUpgradeAddLevel(8, "ZergMeleeWeaponsAI", 2);
    TechTreeUpgradeAddLevel(8, "ZergFlyerArmorAI", 2);
    TechTreeUpgradeAddLevel(7, "MissileTurretDamage", 5);
    TechTreeUpgradeAddLevel(7, "TerranHPUpgrade", 5);
    TechTreeUpgradeAddLevel(7, "UnknownUpgrade", 5);
    TechTreeUpgradeAddLevel(7, "TerranInfantryWeaponsAI", 1);
    TechTreeUpgradeAddLevel(7, "TerranInfantryArmorsAI", 1);
    TechTreeUpgradeAddLevel(7, "GroundArmorAI", 1);
    TechTreeUpgradeAddLevel(7, "ProtossShieldsAI", 1);
    TechTreeUpgradeAddLevel(7, "ProtossGroundWeaponsAI", 1);
    Wait(335.0, c_timeGame);
    TriggerExecute(gt_Upgrade2, true, false);
    return true;
}

//--------------------------------------------------------------------------------------------------
