    gt_BloodToMinerals = TriggerCreate("gt_BloodToMinerals_Func");
    TriggerAddEventUnitRange(gt_BloodToMinerals, null, UnitFromId(604180338), UnitGetPropertyInt(UnitFromId(604180338), c_unitPropEnergyMax, c_unitPropCurrent), true);
}

//--------------------------------------------------------------------------------------------------
// Trigger: TroopTrainingFilter
//--------------------------------------------------------------------------------------------------
bool gt_TroopTrainingFilter_Func (bool testConds, bool runActions) {
    // Automatic Variable Declarations
    // Conditions
    if (testConds) {
        if (!((UnitGetOwner(EventUnit()) == 1))) {
            return false;
        }
    }

    // Actions
    if (!runActions) {
        return true;
    }

    if ((UnitGroupHasUnit(gv_civUnitGroup, EventUnit()) == true)) {
        UnitPutInTransport(EventUnit(), UnitFromId(1146560453));
        UnitIssueOrder(UnitFromId(1146560453), Order(AbilityCommand("BarracksTrain", 0)), c_orderQueueAddToEnd);
        TriggerDebugOutput(1, StringExternal("Param/Value/ABB6D938"), true);
        Wait(20.0, c_timeGame);
        UnitRemove(EventUnit());
        TriggerDebugOutput(1, StringExternal("Param/Value/801D3673"), true);
    }

    if ((UnitGroupHasUnit(gv_marineUnitGroup, EventUnit()) == true)) {
        UnitPutInTransport(EventUnit(), UnitFromId(1146560453));
        UnitIssueOrder(UnitFromId(1146560453), Order(AbilityCommand("MengskMercTrain", 3)), c_orderQueueAddToEnd);
        TriggerDebugOutput(1, StringExternal("Param/Value/FD09E00A"), true);
        Wait(20.0, c_timeGame);
        UnitRemove(EventUnit());
        TriggerDebugOutput(1, StringExternal("Param/Value/E2CBDD00"), true);
    }

    return true;
}

//--------------------------------------------------------------------------------------------------
void gt_TroopTrainingFilter_Init () {
    gt_TroopTrainingFilter = TriggerCreate("gt_TroopTrainingFilter_Func");
    TriggerAddEventUnitRegion(gt_TroopTrainingFilter, null, RegionFromId(2), true);
}

//--------------------------------------------------------------------------------------------------
// Trigger: BarracksUnitGrouper
//--------------------------------------------------------------------------------------------------
bool gt_BarracksUnitGrouper_Func (bool testConds, bool runActions) {
    // Automatic Variable Declarations
    // Actions
    if (!runActions) {
        return true;
    }

    if ((UnitGetType(EventUnit()) == "Marine")) {
        UnitGroupAdd(gv_marineUnitGroup, EventUnit());
    }

    if ((UnitGetType(EventUnit()) == "Firebat")) {
        UnitGroupAdd(gv_firebatUnitGroup, EventUnit());
    }

    return true;
}

