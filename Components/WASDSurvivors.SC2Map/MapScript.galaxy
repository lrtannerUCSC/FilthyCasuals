// Trigger: DomeCivEnter
//--------------------------------------------------------------------------------------------------
bool gt_DomeCivEnter_Func (bool testConds, bool runActions) {
    // Automatic Variable Declarations
    // Conditions
    if (testConds) {
        if (!((UnitGroupHasUnit(UnitGroupFromId(1), EventUnit()) == true))) {
            return false;
        }
    }

    // Actions
    if (!runActions) {
        return true;
    }

    UnitPutInTransport(UnitLastCreated(), UnitFromId(909851322));
    gv_domeCivCount += 1;
    return true;
}

