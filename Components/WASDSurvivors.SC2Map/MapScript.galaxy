//--------------------------------------------------------------------------------------------------
// Trigger: Town Hall Buttons
//--------------------------------------------------------------------------------------------------
bool gt_TownHallButtons_Func (bool testConds, bool runActions) {
    // Automatic Variable Declarations
    unitgroup auto1F72CC95_g;
    int auto1F72CC95_u;
    unit auto1F72CC95_var;

    // Actions
    if (!runActions) {
        return true;
    }

    if ((EventDialogControl() == gv_townHall1)) {
        auto1F72CC95_g = gv_primaryTurretGroup;
        auto1F72CC95_u = UnitGroupCount(auto1F72CC95_g, c_unitCountAll);
        for (;; auto1F72CC95_u -= 1) {
            auto1F72CC95_var = UnitGroupUnitFromEnd(auto1F72CC95_g, auto1F72CC95_u);
            if (auto1F72CC95_var == null) { break; }
            UnitRemove(auto1F72CC95_var);
        }
        libNtve_gf_CreateUnitsWithDefaultFacing(1, "GatlingTurret", 0, 1, PointFromId(1254703413));
        UnitGroupAdd(gv_primaryTurretGroup, UnitLastCreated());
        gv_primaryTurret1 = UnitLastCreated();
        libNtve_gf_CreateUnitsWithDefaultFacing(1, "GatlingTurret", 0, 1, PointFromId(359470782));
        UnitGroupAdd(gv_primaryTurretGroup, UnitLastCreated());
        gv_primaryTurret2 = UnitLastCreated();
        libNtve_gf_CreateUnitsWithDefaultFacing(1, "GatlingTurret", 0, 1, PointFromId(1850856916));
        UnitGroupAdd(gv_primaryTurretGroup, UnitLastCreated());
        gv_primaryTurret3 = UnitLastCreated();
        libNtve_gf_CreateUnitsWithDefaultFacing(1, "GatlingTurret", 0, 1, PointFromId(1014000409));
        UnitGroupAdd(gv_primaryTurretGroup, UnitLastCreated());
        gv_primaryTurret4 = UnitLastCreated();
        libNtve_gf_CreateUnitsWithDefaultFacing(1, "GatlingTurret", 0, 1, PointFromId(1632167838));
        UnitGroupAdd(gv_primaryTurretGroup, UnitLastCreated());
        gv_primaryTurret5 = UnitLastCreated();
        libNtve_gf_CreateUnitsWithDefaultFacing(1, "GatlingTurret", 0, 1, PointFromId(1837512800));
        UnitGroupAdd(gv_primaryTurretGroup, UnitLastCreated());
        gv_primaryTurret6 = UnitLastCreated();
        libNtve_gf_CreateUnitsWithDefaultFacing(1, "GatlingTurret", 0, 1, PointFromId(939566783));
        UnitGroupAdd(gv_primaryTurretGroup, UnitLastCreated());
        gv_primaryTurret7 = UnitLastCreated();
        libNtve_gf_CreateUnitsWithDefaultFacing(1, "GatlingTurret", 0, 1, PointFromId(1027684936));
        UnitGroupAdd(gv_primaryTurretGroup, UnitLastCreated());
        gv_primaryTurret8 = UnitLastCreated();
    }

    if ((EventDialogControl() == gv_townHall2)) {
        if (((UnitGetType(gv_primaryTurret1) != "AutoTurret") && (UnitGetType(gv_primaryTurret1) != "GatlingTurret"))) {
            libNtve_gf_CreateUnitsWithDefaultFacing(1, "AutoTurret", 0, 1, PointFromId(1254703413));
            UnitGroupAdd(gv_primaryTurretGroup, UnitLastCreated());
            gv_primaryTurret1 = UnitLastCreated();
        }

        if (((UnitGetType(gv_primaryTurret2) != "AutoTurret") && (UnitGetType(gv_primaryTurret2) != "GatlingTurret"))) {
            libNtve_gf_CreateUnitsWithDefaultFacing(1, "AutoTurret", 0, 1, PointFromId(359470782));
            UnitGroupAdd(gv_primaryTurretGroup, UnitLastCreated());
            gv_primaryTurret2 = UnitLastCreated();
        }

        if (((UnitGetType(gv_primaryTurret3) != "AutoTurret") && (UnitGetType(gv_primaryTurret3) != "GatlingTurret"))) {
            libNtve_gf_CreateUnitsWithDefaultFacing(1, "AutoTurret", 0, 1, PointFromId(1850856916));
            UnitGroupAdd(gv_primaryTurretGroup, UnitLastCreated());
            gv_primaryTurret3 = UnitLastCreated();
        }

        if (((UnitGetType(gv_primaryTurret4) != "AutoTurret") && (UnitGetType(gv_primaryTurret4) != "GatlingTurret"))) {
            libNtve_gf_CreateUnitsWithDefaultFacing(1, "AutoTurret", 0, 1, PointFromId(1014000409));
            UnitGroupAdd(gv_primaryTurretGroup, UnitLastCreated());
            gv_primaryTurret4 = UnitLastCreated();
        }

        if (((UnitGetType(gv_primaryTurret5) != "AutoTurret") && (UnitGetType(gv_primaryTurret5) != "GatlingTurret"))) {
            libNtve_gf_CreateUnitsWithDefaultFacing(1, "AutoTurret", 0, 1, PointFromId(1632167838));
            UnitGroupAdd(gv_primaryTurretGroup, UnitLastCreated());
            gv_primaryTurret5 = UnitLastCreated();
        }

        if (((UnitGetType(gv_primaryTurret6) != "AutoTurret") && (UnitGetType(gv_primaryTurret6) != "GatlingTurret"))) {
            libNtve_gf_CreateUnitsWithDefaultFacing(1, "AutoTurret", 0, 1, PointFromId(1837512800));
            UnitGroupAdd(gv_primaryTurretGroup, UnitLastCreated());
            gv_primaryTurret6 = UnitLastCreated();
        }

        if (((UnitGetType(gv_primaryTurret7) != "AutoTurret") && (UnitGetType(gv_primaryTurret7) != "GatlingTurret"))) {
            libNtve_gf_CreateUnitsWithDefaultFacing(1, "AutoTurret", 0, 1, PointFromId(939566783));
            UnitGroupAdd(gv_primaryTurretGroup, UnitLastCreated());
            gv_primaryTurret7 = UnitLastCreated();
        }

        if (((UnitGetType(gv_primaryTurret8) != "AutoTurret") && (UnitGetType(gv_primaryTurret8) != "GatlingTurret"))) {
            libNtve_gf_CreateUnitsWithDefaultFacing(1, "AutoTurret", 0, 1, PointFromId(1027684936));
            UnitGroupAdd(gv_primaryTurretGroup, UnitLastCreated());
            gv_primaryTurret8 = UnitLastCreated();
        }

    }

    if ((EventDialogControl() == gv_townHall3)) {
        if ((UnitGetType(gv_primaryBunkerSouth) != "Bunker")) {
            libNtve_gf_CreateUnitsWithDefaultFacing(1, "Bunker", 0, 1, PointFromId(843315713));
            UnitGroupAdd(gv_primaryBunkerGroup, UnitLastCreated());
            gv_primaryBunkerSouth = UnitLastCreated();
        }

        if ((UnitGetType(gv_primaryBunkerNorth) != "Bunker")) {
            libNtve_gf_CreateUnitsWithDefaultFacing(1, "Bunker", 0, 1, PointFromId(1666459151));
            UnitGroupAdd(gv_primaryBunkerGroup, UnitLastCreated());
            gv_primaryBunkerNorth = UnitLastCreated();
        }

        if ((UnitGetType(gv_primaryBunkerEast) != "Bunker")) {
            libNtve_gf_CreateUnitsWithDefaultFacing(1, "Bunker", 0, 1, PointFromId(1442256660));
            UnitGroupAdd(gv_primaryBunkerGroup, UnitLastCreated());
            gv_primaryBunkerEast = UnitLastCreated();
        }

        if ((UnitGetType(gv_primaryBunkerWest) != "Bunker")) {
            libNtve_gf_CreateUnitsWithDefaultFacing(1, "Bunker", 0, 1, PointFromId(1869422634));
            UnitGroupAdd(gv_primaryBunkerGroup, UnitLastCreated());
            gv_primaryBunkerWest = UnitLastCreated();
        }

    }

    if ((EventDialogControl() == gv_minimizeTownHall)) {
        DialogSetVisible(gv_townHallDialog, PlayerGroupSingle(EventPlayer()), false);
    }

    return true;
}

