//--------------------------------------------------------------------------------------------------
// Trigger: CivSpawnerGrouper
//--------------------------------------------------------------------------------------------------
bool gt_CivSpawnerGrouper_Func (bool testConds, bool runActions) {
    // Variable Declarations
    unit lv_civ;
    int lv_numCivs;

    // Automatic Variable Declarations
    // Variable Initialization

    // Actions
    if (!runActions) {
        return true;
    }

    lv_civ = EventUnitCreatedUnit();
    UnitGroupAdd(gv_civUnitGroup, lv_civ);
    UnitIssueOrder(lv_civ, OrderTargetingPoint(AbilityCommand("move", 0), RegionRandomPoint(RegionFromId(10))), c_orderQueueReplace);
    lv_numCivs = UnitGroupCount(gv_civUnitGroup, c_unitCountAll);
    return true;
}

//--------------------------------------------------------------------------------------------------
void gt_CivSpawnerGrouper_Init () {
    gt_CivSpawnerGrouper = TriggerCreate("gt_CivSpawnerGrouper_Func");
    TriggerAddEventUnitCreated(gt_CivSpawnerGrouper, UnitRefFromUnit(UnitFromId(2027491687)), null, null);
    TriggerAddEventUnitCreated(gt_CivSpawnerGrouper, UnitRefFromUnit(UnitFromId(1746630043)), null, null);
    TriggerAddEventUnitCreated(gt_CivSpawnerGrouper, UnitRefFromUnit(UnitFromId(687521640)), null, null);
    TriggerAddEventUnitCreated(gt_CivSpawnerGrouper, UnitRefFromUnit(UnitFromId(1516766081)), null, null);
}

