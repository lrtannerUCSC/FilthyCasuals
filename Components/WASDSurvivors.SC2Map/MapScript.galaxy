//--------------------------------------------------------------------------------------------------
// Trigger: Protoss Upgrades Buttons
//--------------------------------------------------------------------------------------------------
bool gt_ProtossUpgradesButtons_Func (bool testConds, bool runActions) {
    // Automatic Variable Declarations
    // Actions
    if (!runActions) {
        return true;
    }

    if ((EventDialogControl() == gv_groundUpgradesButton)) {
        DialogSetVisible(gv_chooseUpgradesSectionProtoss, PlayerGroupSingle(EventPlayer()), false);
        DialogSetVisible(gv_groundUpgradesDialog, PlayerGroupSingle(EventPlayer()), true);
    }

    if ((EventDialogControl() == gv_airUpgradesButton)) {
        DialogSetVisible(gv_chooseUpgradesSectionProtoss, PlayerGroupSingle(EventPlayer()), false);
        DialogSetVisible(gv_airUpgradesDialog, PlayerGroupSingle(EventPlayer()), true);
    }

    if ((EventDialogControl() == gv_protossSpecialUpgradesButton)) {
        DialogSetVisible(gv_chooseUpgradesSectionProtoss, PlayerGroupSingle(EventPlayer()), false);
        DialogSetVisible(gv_protossSpecialUpgradesDialog, PlayerGroupSingle(EventPlayer()), true);
    }

    if ((EventDialogControl() == gv_shieldsButton1)) {
        if ((TechTreeUpgradeCount(EventPlayer(), "ProtossShieldsLevel1", c_techCountCompleteOnly) != 1) && (PlayerGetPropertyInt(EventPlayer(), c_playerPropMinerals) > 1250)) {
            libNtve_gf_SetUpgradeLevelForPlayer(EventPlayer(), "ProtossShieldsLevel1", 1);
            DialogControlSetVisible(EventDialogControl(), PlayerGroupSingle(EventPlayer()), false);
        }

    }

    if ((EventDialogControl() == gv_shieldsButton2)) {
        if ((TechTreeUpgradeCount(EventPlayer(), "ProtossShieldsLevel2", c_techCountCompleteOnly) != 1) && (TechTreeUpgradeCount(EventPlayer(), "ProtossShieldsLevel1", c_techCountCompleteOnly) == 1) && (PlayerGetPropertyInt(EventPlayer(), c_playerPropMinerals) > 1250)) {
            libNtve_gf_SetUpgradeLevelForPlayer(EventPlayer(), "ProtossShieldsLevel2", 1);
            DialogControlSetVisible(EventDialogControl(), PlayerGroupSingle(EventPlayer()), false);
        }

    }

    if ((EventDialogControl() == gv_minimizeProtossUpgradesDialog)) {
        DialogSetVisible(gv_chooseUpgradesSectionProtoss, PlayerGroupSingle(EventPlayer()), false);
        DialogSetVisible(gv_minimizedUpgradeDialog, PlayerGroupSingle(EventPlayer()), true);
    }

    if ((EventDialogControl() == gv_backtoUpgradesProtoss)) {
        DialogSetVisible(gv_chooseUpgradesSectionProtoss, PlayerGroupSingle(EventPlayer()), false);
        DialogSetVisible(gv_upgradeMainDialog, PlayerGroupSingle(EventPlayer()), true);
    }

    return true;
}

