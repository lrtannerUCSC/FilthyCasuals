//--------------------------------------------------------------------------------------------------
// Trigger: Barracks Dialog Buttons
//--------------------------------------------------------------------------------------------------
bool gt_BarracksDialogButtons_Func (bool testConds, bool runActions) {
    // Variable Declarations
    unit lv_marine;
    unit lv_civ;

    // Automatic Variable Declarations
    // Variable Initialization

    // Actions
    if (!runActions) {
        return true;
    }

    if ((EventDialogControl() == gv_barracksTroop1)) {
        if ((UnitQueueItemCount(UnitFromId(1146560453), 7) < 1)) {
            if ((UnitGroupCount(gv_civUnitGroup, c_unitCountAll) >= 1)) {
                TriggerDebugOutput(1, StringExternal("Param/Value/ECB7C7D0"), true);
                lv_civ = UnitGroupRandomUnit(gv_civUnitGroup, c_unitCountAlive);
                UnitIssueOrder(lv_civ, OrderTargetingUnit(AbilityCommand("move", 0), UnitFromId(1146560453)), c_orderQueueReplace);
            }
            else {
                TriggerDebugOutput(1, StringExternal("Param/Value/309C0941"), true);
            }
        }
        else {
            TriggerDebugOutput(1, StringExternal("Param/Value/E012187D"), true);
        }
    }

    if ((EventDialogControl() == gv_barracksTroop2)) {
        if ((UnitQueueItemCount(UnitFromId(1146560453), 7) < 1)) {
            if ((UnitGroupCount(gv_marineUnitGroup, c_unitCountAll) >= 1)) {
                TriggerDebugOutput(1, StringExternal("Param/Value/5354E5F1"), true);
                lv_marine = UnitGroupRandomUnit(gv_marineUnitGroup, c_unitCountAlive);
                UnitIssueOrder(lv_marine, OrderTargetingUnit(AbilityCommand("move", 0), UnitFromId(1146560453)), c_orderQueueReplace);
            }
            else {
                TriggerDebugOutput(1, StringExternal("Param/Value/34225FD7"), true);
            }
        }
        else {
            TriggerDebugOutput(1, StringExternal("Param/Value/C3D08366"), true);
        }
    }

    if ((EventDialogControl() == gv_minimizeBarracks)) {
        DialogSetVisible(gv_barracksDialog, PlayerGroupSingle(EventPlayer()), false);
    }

    return true;
}

//--------------------------------------------------------------------------------------------------
void gt_BarracksDialogButtons_Init () {
    gt_BarracksDialogButtons = TriggerCreate("gt_BarracksDialogButtons_Func");
    TriggerAddEventDialogControl(gt_BarracksDialogButtons, c_playerAny, c_invalidDialogControlId, c_triggerControlEventTypeClick);
}

