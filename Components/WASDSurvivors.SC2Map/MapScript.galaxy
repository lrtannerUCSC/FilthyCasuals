//--------------------------------------------------------------------------------------------------
// Trigger: EBay Buttons
//--------------------------------------------------------------------------------------------------
bool gt_EBayButtons_Func (bool testConds, bool runActions) {
    // Automatic Variable Declarations
    // Actions
    if (!runActions) {
        return true;
    }

    if ((EventDialogControl() == gv_eBay1) && (AIHasRes(1, 300, 0) == true)) {
        PlayerModifyPropertyInt(1, c_playerPropMinerals, c_playerPropOperSubtract, 300);
        UnitSetPropertyFixed(UnitFromId(604180338), c_unitPropEnergyMax, (UnitGetPropertyInt(UnitFromId(604180338), c_unitPropEnergyMax, c_unitPropCurrent)+2.0));
        TriggerDebugOutput(1, StringExternal("Param/Value/A8D80365"), true);
    }

    if ((EventDialogControl() == gv_eBay2) && (AIHasRes(1, 200, 0) == true)) {
        PlayerModifyPropertyInt(1, c_playerPropMinerals, c_playerPropOperSubtract, 200);
        UnitSetPropertyFixed(UnitFromId(604180338), c_unitPropBaseMovementSpeed, (UnitGetPropertyInt(UnitFromId(604180338), c_unitPropBaseMovementSpeed, c_unitPropCurrent)+1.0));
        TriggerDebugOutput(1, StringExternal("Param/Value/45541FD1"), true);
    }

    if ((EventDialogControl() == gv_minimizeEBay)) {
        DialogSetVisible(gv_eBayDialog, PlayerGroupSingle(EventPlayer()), false);
    }

    return true;
}

