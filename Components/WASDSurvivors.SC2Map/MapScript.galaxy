    gv_minimizeTerranUpgradesDialog = DialogControlLastCreated();
    libNtve_gf_SetDialogItemColor(gv_minimizeInfantryUpgradesDialog, Color(0,66*100/255,100), PlayerGroupSingle(EventPlayer()));
    libNtve_gf_CreateDialogItemButton(gv_chooseUpgradesSectionTerran, 250, 50, c_anchorTopLeft, 50, 50, StringExternal("Param/Value/73D5669D"), StringExternal("Param/Value/56EFCB7F"), "");
    gv_infantryUpgradesButton = DialogControlLastCreated();
    libNtve_gf_CreateDialogItemButton(gv_chooseUpgradesSectionTerran, 250, 50, c_anchorTopLeft, 50, 100, StringExternal("Param/Value/4FBA49DA"), StringExternal("Param/Value/58633DD1"), "");
    gv_vehicleUpgradesButton = DialogControlLastCreated();
    libNtve_gf_CreateDialogItemButton(gv_chooseUpgradesSectionTerran, 250, 50, c_anchorTopLeft, 50, 150, StringExternal("Param/Value/D23B6102"), StringExternal("Param/Value/D3872980"), "");
    gv_shipUpgradesButton = DialogControlLastCreated();
    libNtve_gf_CreateDialogItemButton(gv_chooseUpgradesSectionTerran, 250, 50, c_anchorTopLeft, 50, 200, StringExternal("Param/Value/88332EB2"), StringExternal("Param/Value/4819BBB6"), "");
    gv_terranSpecialUpgradesButton = DialogControlLastCreated();
    libNtve_gf_CreateDialogItemButton(gv_chooseUpgradesSectionTerran, 75, 50, c_anchorBottomRight, 25, 25, StringExternal("Param/Value/0D316228"), StringExternal("Param/Value/21774B55"), "");
    gv_backtoUpgradesTerran = DialogControlLastCreated();
    return true;
}

//--------------------------------------------------------------------------------------------------
