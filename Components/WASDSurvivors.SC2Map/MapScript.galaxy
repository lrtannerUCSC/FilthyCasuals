//--------------------------------------------------------------------------------------------------
// Trigger: Bloodsplat Creation
//--------------------------------------------------------------------------------------------------
bool gt_BloodsplatCreation_Func (bool testConds, bool runActions) {
    // Automatic Variable Declarations
    // Actions
    if (!runActions) {
        return true;
    }

    libNtve_gf_CreateUnitsWithDefaultFacing(1, "Bloodsplat", 0, 0, UnitGetPosition(EventUnit()));
    return true;
}

//--------------------------------------------------------------------------------------------------
void gt_BloodsplatCreation_Init () {
    gt_BloodsplatCreation = TriggerCreate("gt_BloodsplatCreation_Func");
    TriggerAddEventUnitDied(gt_BloodsplatCreation, null);
}

//--------------------------------------------------------------------------------------------------
// Trigger: BloodToMinerals
//--------------------------------------------------------------------------------------------------
bool gt_BloodToMinerals_Func (bool testConds, bool runActions) {
    // Automatic Variable Declarations
    // Conditions
    if (testConds) {
        if (!((UnitGetType(EventUnit()) == "Bloodsplat"))) {
            return false;
        }
    }

    // Actions
    if (!runActions) {
        return true;
    }

    PlayerModifyPropertyInt(1, c_playerPropMinerals, c_playerPropOperAdd, 10);
    UnitRemove(EventUnit());
    TriggerDebugOutput(1, StringExternal("Param/Value/98EBF589"), true);
    return true;
}

//--------------------------------------------------------------------------------------------------
void gt_BloodToMinerals_Init () {
    gt_BloodToMinerals = TriggerCreate("gt_BloodToMinerals_Func");
    TriggerAddEventUnitRange(gt_BloodToMinerals, null, UnitFromId(604180338), UnitGetPropertyInt(UnitFromId(604180338), c_unitPropEnergyMax, c_unitPropCurrent), true);
}

