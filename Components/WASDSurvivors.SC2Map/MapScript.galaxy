//--------------------------------------------------------------------------------------------------
// Trigger: ZombieSpawnerSpawner
//--------------------------------------------------------------------------------------------------
bool gt_ZombieSpawnerSpawner_Func (bool testConds, bool runActions) {
    // Automatic Variable Declarations
    // Actions
    if (!runActions) {
        return true;
    }

    libNtve_gf_CreateUnitsAtPoint2(1, "InfestedTerranSpawner", 0, 2, UnitTypePlacementFromPoint("InfestedTerranSpawner", 2, RegionRandomPoint(RegionFromId(13)), 15.0));
    return true;
}

//--------------------------------------------------------------------------------------------------
void gt_ZombieSpawnerSpawner_Init () {
    gt_ZombieSpawnerSpawner = TriggerCreate("gt_ZombieSpawnerSpawner_Func");
    TriggerAddEventTimePeriodic(gt_ZombieSpawnerSpawner, 120.0, c_timeGame);
}

//--------------------------------------------------------------------------------------------------
// Trigger: ZombieRunner(Basic)
//--------------------------------------------------------------------------------------------------
bool gt_ZombieRunnerBasic_Func (bool testConds, bool runActions) {
    // Automatic Variable Declarations
    // Conditions
    if (testConds) {
        if (!((UnitGetOwner(EventUnit()) == 2))) {
            return false;
        }
    }

    // Actions
    if (!runActions) {
        return true;
    }

    Wait(2.0, c_timeGame);
    UnitIssueOrder(EventUnit(), OrderTargetingRelativePoint(AbilityCommand("attack", 0), PointFromId(1498365247)), c_orderQueueReplace);
    return true;
}

//--------------------------------------------------------------------------------------------------
void gt_ZombieRunnerBasic_Init () {
    gt_ZombieRunnerBasic = TriggerCreate("gt_ZombieRunnerBasic_Func");
    TriggerAddEventUnitRegion(gt_ZombieRunnerBasic, null, RegionFromId(12), true);
}

//--------------------------------------------------------------------------------------------------
// Trigger: UnitInfectionTrigger
//--------------------------------------------------------------------------------------------------
bool gt_UnitInfectionTrigger_Func (bool testConds, bool runActions) {
    // Automatic Variable Declarations
    // Conditions
    if (testConds) {
        if (!(((UnitGetOwner(EventUnit()) == 1) && ((UnitGetType(EventUnit()) == "Civilian") || (UnitGetType(EventUnit()) == "Marine"))))) {
            return false;
        }
    }

    // Actions
    if (!runActions) {
        return true;
    }

    libNtve_gf_ReplaceUnit(EventUnit(), "StukovInfestedTerran", libNtve_ge_ReplaceUnitOptions_NewUnitsDefault);
    libNtve_gf_RescueUnit(libNtve_gf_LastReplacedUnit(), 2, false);
    return true;
}

//--------------------------------------------------------------------------------------------------
void gt_UnitInfectionTrigger_Init () {
    gt_UnitInfectionTrigger = TriggerCreate("gt_UnitInfectionTrigger_Func");
    TriggerAddEventUnitAttacked2(gt_UnitInfectionTrigger, null, "InfestedClaws");
}

