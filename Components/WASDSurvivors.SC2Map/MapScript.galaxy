    TriggerAddEventMapInit(gt_TerranUpgradesDialog);
}

//--------------------------------------------------------------------------------------------------
// Trigger: Terran Upgrades Buttons
//--------------------------------------------------------------------------------------------------
bool gt_TerranUpgradesButtons_Func (bool testConds, bool runActions) {
    // Automatic Variable Declarations
    // Actions
    if (!runActions) {
        return true;
    }

    if ((EventDialogControl() == gv_infantryUpgradesButton)) {
        DialogSetVisible(gv_chooseUpgradesSectionTerran, PlayerGroupSingle(EventPlayer()), false);
        DialogSetVisible(gv_infantryUpgradesDialog, PlayerGroupSingle(EventPlayer()), true);
    }

    if ((EventDialogControl() == gv_vehicleUpgradesButton)) {
        DialogSetVisible(gv_chooseUpgradesSectionTerran, PlayerGroupSingle(EventPlayer()), false);
        DialogSetVisible(gv_vehicleUpgradesDialog, PlayerGroupSingle(EventPlayer()), true);
    }

    if ((EventDialogControl() == gv_shipUpgradesButton)) {
        DialogSetVisible(gv_chooseUpgradesSectionTerran, PlayerGroupSingle(EventPlayer()), false);
        DialogSetVisible(gv_shipUpgradesDialog, PlayerGroupSingle(EventPlayer()), true);
    }

    if ((EventDialogControl() == gv_terranSpecialUpgradesButton)) {
        DialogSetVisible(gv_chooseUpgradesSectionTerran, PlayerGroupSingle(EventPlayer()), false);
        DialogSetVisible(gv_terranSpecialUpgradesDialog, PlayerGroupSingle(EventPlayer()), true);
    }

    if ((EventDialogControl() == gv_minimizeTerranUpgradesDialog)) {
        DialogSetVisible(gv_chooseUpgradesSectionTerran, PlayerGroupSingle(EventPlayer()), false);
        DialogSetVisible(gv_minimizedUpgradeDialog, PlayerGroupSingle(EventPlayer()), true);
    }

    if ((EventDialogControl() == gv_backtoUpgradesTerran)) {
        DialogSetVisible(gv_chooseUpgradesSectionTerran, PlayerGroupSingle(EventPlayer()), false);
        DialogSetVisible(gv_upgradeMainDialog, PlayerGroupSingle(EventPlayer()), true);
    }

    return true;
}

//--------------------------------------------------------------------------------------------------
void gt_TerranUpgradesButtons_Init () {
    gt_TerranUpgradesButtons = TriggerCreate("gt_TerranUpgradesButtons_Func");
    TriggerAddEventDialogControl(gt_TerranUpgradesButtons, EventPlayer(), c_invalidDialogControlId, c_triggerControlEventTypeClick);
}

